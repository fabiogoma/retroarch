# Source allowlist: downloaded content and device snapshots stay local.
/*
!/.gitignore
!/README.md
!/COPILOT_HANDOFF.md
!/RESUME_WITH_COPILOT.md
!/.github/
!/.github/copilot-instructions.md
!/.github/workflows/
!/.github/workflows/checks.yml
!/docs/
/docs/*
!/docs/OPERATIONS.md
!/docs/DOWNLOADS.md
!/rom_library/
/rom_library/*
!/rom_library/*.py
!/rom_library/README.md
!/rom_library/consoles.json
!/rom_library/curation.json
!/rom_library/apple_tv_cores.json
!/rom_library/archive_sources.example.json
!/rom_library/bezels/
/rom_library/bezels/*
!/rom_library/bezels/*.cfg
!/rom_library/bezels/README.md
!/rom_library/bezels/LICENSE
!/rom_library/bezels/sources.json
!/rom_library/bezels/overrides/
!/config/
/config/*
!/config/apple-tv.cfg
!/config/global.slangp
!/config/pce-six-button.opt

# Also protect against accidental assets inside source directories.
**/__pycache__/
**/.DS_Store
**/*.pyc
**/*.png
**/*.jpg
**/*.jpeg
**/*.gif
**/*.webp
**/*.zip
**/*.7z
**/*.rar
**/*.nes
**/*.sfc
**/*.smc
**/*.n64
**/*.z64
**/*.v64
**/*.sms
**/*.pce
**/*.gen
**/*.smd
**/*.bin
**/*.iso
**/*.chd
**/*.gba
**/*.gb
**/*.gbc
**/*.sqlite
**/*.bak
**/*.local.json
