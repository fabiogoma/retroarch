# Source allowlist: ROMs, artwork, exports, and local state stay outside Git.
/*
!/.gitignore
!/go.mod
!/go.sum
!/retroarch-tool.yaml
!/main.go
!/cmd/
!/cmd/*.go
!/internal/
!/internal/**
!/README.md
!/.github/
!/.github/copilot-instructions.md
!/.github/workflows/
!/.github/workflows/checks.yml
!/config/
/config/*
!/config/apple-tv.cfg
!/config/global.slangp
!/config/pce-six-button.opt
!/config/consoles.json
!/config/curation.json
!/config/apple_tv_cores.json
!/config/bezels/
/config/bezels/*
!/config/bezels/*.cfg
!/config/bezels/README.md
!/config/bezels/LICENSE
!/config/bezels/sources.json
!/config/bezels/overrides/

# Also protect against accidental assets inside source directories.
**/.DS_Store
**/*.png
**/*.jpg
**/*.jpeg
**/*.gif
**/*.webp
**/*.zip
**/*.7z
**/*.rar
**/*.nes
**/*.sfc
**/*.smc
**/*.n64
**/*.z64
**/*.v64
**/*.sms
**/*.pce
**/*.gen
**/*.smd
**/*.bin
**/*.iso
**/*.chd
**/*.gba
**/*.gb
**/*.gbc
**/*.sqlite
**/*.bak
**/*.local.json
